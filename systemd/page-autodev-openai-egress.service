[Unit]
Description=Page AutoDev OpenAI egress broker (disabled transport)
Requires=page-autodev-openai-egress.socket
After=page-autodev-openai-egress.socket page-autodev-openai-tunnel.socket
Requires=page-autodev-openai-tunnel.socket

[Service]
Type=simple
User=page-autodev-openai-egress
Group=page-autodev-openai-egress
WorkingDirectory=/opt/page-autodev
ExecStart=/usr/bin/node --jitless /opt/page-autodev/bin/page-autodev-openai-egress-daemon.mjs
LoadCredential=egress_policy:/etc/page-autodev/credentials/egress-policy.json
LoadCredential=gateway_assertion_secret:/etc/page-autodev/credentials/gateway-assertion-secret
LoadCredential=openai_api_key:/etc/page-autodev/credentials/openai-api-key
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
CapabilityBoundingSet=
RemoveIPC=true
PrivateDevices=true
PrivateNetwork=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProcSubset=pid
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
IPAddressDeny=any
UMask=0077
