[Unit]
Description=Page AutoDev Billing Gateway
Requires=page-autodev-billing-gateway.socket
After=page-autodev-billing-gateway.socket

[Service]
Type=simple
User=page-autodev-billing-gateway
Group=page-autodev-billing-gateway
SupplementaryGroups=page-autodev-egress
WorkingDirectory=/opt/page-autodev
ExecStart=/usr/bin/node /opt/page-autodev/bin/page-autodev-billing-gateway-daemon.mjs
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
CapabilityBoundingSet=
RemoveIPC=true
PrivateDevices=true
PrivateNetwork=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProcSubset=pid
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
IPAddressDeny=any
UMask=0077
