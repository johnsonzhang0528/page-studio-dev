[Unit]
Description=Page Studio 專案 %i 全自動開發服務
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/page-studio-dev/projects/%i
ExecStart=%h/page-studio-dev/bin/page-autodev run %i
SuccessExitStatus=75
Nice=10
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=30s

[Install]
WantedBy=default.target
