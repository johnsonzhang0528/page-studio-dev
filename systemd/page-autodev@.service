[Unit]
Description=Page Studio 專案 %i 全自動開發服務
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/page-studio-dev/projects/%i
ExecStart=%h/page-studio-dev/bin/page-autodev run %i
SuccessExitStatus=75
Nice=10
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
ReadOnlyPaths=%h/page-studio-dev %h/.local/bin/claude %h/.claude %h/.config/page-autodev/telegram.env
ReadWritePaths=%h/page-studio-dev/projects/%i %h/.cache/claude
InaccessiblePaths=%h/.ssh %h/.aws %h/.azure %h/.kube %h/.docker %h/.gnupg

[Install]
WantedBy=default.target
