[Unit]
Description=Refresh Page AutoDev controller billing credential

[Service]
Type=oneshot
Group=page-autodev-workers
WorkingDirectory=/opt/page-autodev
ExecStart=/usr/bin/node /opt/page-autodev/bin/page-autodev-issue-controller-credential.mjs
LoadCredential=gateway_credential_secret:/etc/page-autodev/credentials/gateway-credential-secret
Environment=CONTROLLER_CREDENTIAL_OUTPUT=/etc/page-autodev/credentials/billing-reservation-credential
Environment=CONTROLLER_CREDENTIAL_GENERATION=wave-a
Environment=CONTROLLER_CREDENTIAL_TTL_MS=86400000
Environment=CONTROLLER_CREDENTIAL_OUTPUT_MODE=0640
ReadWritePaths=/etc/page-autodev/credentials
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateDevices=true
PrivateNetwork=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
IPAddressDeny=any
UMask=0027
