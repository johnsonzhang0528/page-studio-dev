{
  "schema_version": 1,
  "enabled": false,
  "model": "sonnet",
  "effort": "high",
  "fallback_model": "sonnet",
  "stage_models": {
    "input_analysis": { "model": "sonnet", "effort": "medium" },
    "requirements": { "model": "sonnet", "effort": "high" },
    "requirements_gate": { "model": "opus", "effort": "high" },
    "architecture": { "model": "sonnet", "effort": "high" },
    "architecture_gate": { "model": "opus", "effort": "high" },
    "specification": { "model": "sonnet", "effort": "high" },
    "specification_gate": { "model": "opus", "effort": "high" },
    "planning": { "model": "sonnet", "effort": "high" },
    "planning_gate": { "model": "opus", "effort": "high" },
    "implementation": { "model": "sonnet", "effort": "high" },
    "implementation_gate": { "model": "opus", "effort": "high" },
    "qa": { "model": "opus", "effort": "high" }
  },
  "max_turns_per_stage": 40,
  "turn_budget": {
    "strategy": "task_type_adaptive",
    "implementation_base": 24,
    "continuation_increment": 4,
    "maximum": 32,
    "complexity_signals": true
  },
  "gate_efficiency": {
    "artifact_hash_fast_pass": true,
    "difference_first_review": true,
    "targeted_review_model": "sonnet",
    "final_regression_model": "opus"
  },
  "complexity_control": {
    "enabled": true,
    "source": "Ponytail decision ladder (controller-native adapter; https://github.com/DietrichGebert/ponytail)",
    "rollout": "shadow",
    "pilot_tasks": 10,
    "default_mode": "full",
    "high_risk_mode": "lite",
    "allow_ultra": false,
    "protected_complexity": [
      "已核准需求、ADR 與公開契約",
      "安全、資料完整性、交易、冪等與可靠性控制",
      "Migration、備份、復原、稽核與必要可觀測性",
      "原任務 verification 與 governance_rules"
    ],
    "review": {
      "strategy": "conditional",
      "file_threshold": 5,
      "added_lines_threshold": 150,
      "max_rounds_per_task": 1
    }
  },
  "result_compaction": {
    "enabled": true,
    "preserve_raw_log": true,
    "history_summary_max_chars": 1200,
    "history_evidence_max_items": 8
  },
  "max_repair_attempts": 3,
  "repair_loops": {
    "max_total_per_gate": 8,
    "max_hard_total_per_gate": 20,
    "max_consecutive_no_progress": 3,
    "max_same_target": 2,
    "max_target_fraction": 0.4,
    "targeted_repair": true
  },
  "semantic_freeze": {
    "max_total_attempts": 6,
    "max_same_artifact_failures": 2,
    "max_consecutive_no_progress": 2
  },
  "quota_retry_minutes": 30,
  "quota_retry_delay_minutes": 5,
  "stage_timeout_minutes": 90,
  "context_management": {
    "fresh_session_per_stage": true,
    "no_session_persistence": true,
    "resume_same_work_unit": true,
    "phase_scoped_context": true,
    "markdown_first": true,
    "auto_compact_percent": 80
  },
  "work_units": {
    "enabled": true,
    "post_interrupt_acceptance": true,
    "max_continuations_per_unit": 3,
    "max_total_continuations_per_cycle": 8,
    "max_no_progress_attempts": 2,
    "max_repair_attempts_per_unit": 2
  },
  "workflow_efficiency": {
    "semantic_freeze_before_render": true,
    "full_visual_check_final_only": true,
    "architecture_visual_delivery": "final_only",
    "adr_admission_required": true,
    "draft_adr_until_gate": true,
    "defer_deployment_risks_to_release_gate": true,
    "context_sync_after_gate_only": true,
    "skip_runtime_only_git_commits": true
  },
  "parallel_execution": {
    "enabled": true,
    "max_concurrency": 2,
    "read_only_gates": true,
    "isolated_write_worktrees": true,
    "auto_reduce_on_quota_pressure": true
  },
  "auto_commit": false,
  "auto_checkpoint_commits": true,
  "git_checkpoint_identity": {
    "name": "Page Studio Autodev",
    "email": "autodev@page-studio.local"
  },
  "machine_quality_gates": true,
  "allow_push": false,
  "allow_deploy": false
}
